# IMPORTANT: must match the robot's ROS_DOMAIN_ID exactly, or you won't
# see any of its topics even though the Zenoh connection itself works -
# domain ID is part of Zenoh's topic key-expression namespacing, same
# isolation effect as with DDS. ROS_DOMAIN_ID = robot number (turtlebot09 -> 9).
ROS_DOMAIN_ID=9
# IP of the turtlebot's Zenoh router: the robot's own address on its access
# point TB-AP-<nr>, i.e. 10.0.<nr>.10 (see turtlebot_setup/docs/ap-migration.md).
# Your laptop must be on that robot's wifi (TB-AP-<nr>).
ROBOT_ZENOH_IP=10.0.9.10
