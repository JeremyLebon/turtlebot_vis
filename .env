# IMPORTANT: must match the robot's ROS_DOMAIN_ID exactly, or you won't
# see any of its topics even though the Zenoh connection itself works -
# domain ID is part of Zenoh's topic key-expression namespacing, same
# isolation effect as with DDS. Current test robot (turtlebot_99) uses 99.
ROS_DOMAIN_ID=99
# IP of the turtlebot's Zenoh router. For the current test robot this is
# its direct IP; once per-robot access points are set up, this becomes
# the robot's AP gateway IP (typically 10.42.0.1).
ROBOT_ZENOH_IP=192.168.60.69
