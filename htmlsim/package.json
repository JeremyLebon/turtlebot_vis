  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "three": "0.160.0",
    "@xmldom/xmldom": "0.8.10",
    "puppeteer-core": "23.10.4",
    "@sparticuz/chromium": "131.0.1",
    "ws": "8.18.0"
  }
}
